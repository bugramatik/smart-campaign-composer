# Copy to .env. Everything is optional: without a key the app runs with the
# built-in demo LLM (keyword heuristics) so it can be tried offline.

# Claude. Never commit a real key; .env is git-ignored.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Server-side fallback to another model if the primary declines/overloads.
LLM_FALLBACKS=true
# anthropic | mock (mock = the built-in demo heuristics; default: anthropic
# if a key is set, else mock)
LLM_PROVIDER=
LLM_MAX_ATTEMPTS=3

# Delivery
RATE_PER_SECOND=100
WORKER_CONCURRENCY=32
DELIVERY_MAX_ATTEMPTS=8
RETRY_BASE_DELAY=500ms
RETRY_MAX_DELAY=30s
PROVIDER_TIMEOUT=3s

# Mock provider fault injection
MOCK_RATE_LIMIT=120
MOCK_429_RATE=0.03
MOCK_500_RATE=0.03
MOCK_TIMEOUT_RATE=0.01
